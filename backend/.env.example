# Application
APP_NAME=LangGraph 智能旅行助手
APP_VERSION=2.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE_ENABLED=true
# 默认日志位置 backend/logs；LOG_DIR 可选自定义绝对路径

# 本地 PostgreSQL；dev.py 自动生成独立非管理员账号并注入此变量。
# 不要把数据库密码放进前端或提交 Git。应用在容器内使用 postgres:5432。
DATABASE_URL=
# 本地 HTTP 为 false；将来使用 HTTPS 时设为 true。
SESSION_COOKIE_SECURE=false
DAILY_TRIP_LIMIT=3
MAX_CONCURRENT_RUNS=2
MAX_RESUME_ATTEMPTS=3
SSE_HEARTBEAT_SECONDS=15

# Provider-neutral LLM configuration
# deepseek, openai, anthropic, google_genai, ollama, azure_openai,
# openai_compatible, or any other installed LangChain integration.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUT_MODE=auto
LLM_THINKING_MODE=auto
# JSON object for provider-specific options, for example Azure deployment fields.
LLM_MODEL_KWARGS={}

# Planner behavior
PLANNER_MAX_ATTEMPTS=3
PLANNER_REQUEST_TIMEOUT=600
PLANNER_ENABLE_RERANK=true
PLANNER_RERANK_CANDIDATE_COUNT=3
PLANNER_RERANK_TEMPERATURE_STEP=0.08

# External data sources
AMAP_API_KEY=your-amap-web-service-key
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
