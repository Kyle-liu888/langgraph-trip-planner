# Copy to deploy/secrets/backend.env and replace placeholder values locally.
LLM_PROVIDER=deepseek
LLM_MODEL=your-model-id
LLM_API_KEY=replace-with-model-api-key
LLM_BASE_URL=https://api.deepseek.com
AMAP_API_KEY=replace-with-amap-web-service-key
DATABASE_URL=postgresql://trip_app:replace-with-app-password@postgres:5432/trip
DAILY_TRIP_LIMIT=3
MAX_RESUME_ATTEMPTS=3
