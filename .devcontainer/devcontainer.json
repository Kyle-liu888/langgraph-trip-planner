{
  "name": "旅行助手 · 本地隔离开发",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",
  "updateRemoteUserUID": false,
  "overrideCommand": false,
  "shutdownAction": "none",
  "postCreateCommand": "bash scripts/container-setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "Vue.volar"],
      "settings": { "python.defaultInterpreterPath": "/workspace/backend/.venv/bin/python" }
    }
  }
}
